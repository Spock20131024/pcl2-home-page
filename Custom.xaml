            <local:MyListItem Margin="10,10,0,0"
            Logo="pack://application:,,,/images/Blocks/GoldBlock.png"
            Title=" LTW3  " Info="imyyds" EventType="启动游戏" EventData="1.18.2|mc.hexdragon.top" Type="Clickable" />
